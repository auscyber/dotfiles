{
  den,
  lib,
  caps,
  config,
  inputs,
  serviceLibs,
  ...
}:
# Services, in two layers that are being merged.
#
# OLD (built, in use): a service is declared by the HOUSEHOLD and claimed by a
# HOST with `services.<n>.enable`. `host.serves` is the intersection, with a
# throw on a claim the household does not declare. ../../lib/service-type.nix is
# that instance type; ../services/access.nix traverses it.
#
# NEW (plan §3b): `den.services.<key>`, top-level, OWNED by anything (a
# household, a host, or the fleet) and IDENTIFIED BY ITS RESOLVED DEPENDENCIES --
# `main/celler@secondpc`, where `/` is a service dependency and `@` is placement
# on a host, following den's own identity notation in fx/identity.nix.
# ../../lib/service-dep-type.nix is that type, ../services/celler-service.nix
# the worked case.
#
# Both exist at once deliberately: the old layer has five live consumers and the
# new one is additive until they are migrated.
#
# Direction holds throughout: host -> household -> service, and a service's
# `parent`/`wants` point at other services, never back at an entity that
# resolves aspects. "Which hosts serve this" is answered by
# `_module.args.serviceHosts` below, which walks the fleet at FILE level where
# the direction rule is not at stake.
let
  inherit (lib) mkOption types;
in
{
  # DEFINITIONS AND INSTANCES ARE DIFFERENT COLLECTIONS, and they have to be.
  #
  # `den.serviceTypes.<class>` is a SCHEMA -- what that kind of service IS, with
  # no host, because the same schema instantiates anywhere: not all cellers are
  # on secondpc. `den.services.<key>` holds INSTANCES, generated by
  # ./service-instances.nix from what each host says it runs.
  #
  # ONE COLLECTION CANNOT DO BOTH, and this is not a matter of taste -- it was
  # measured. The cascade that implies sub-instances has to read a definition's
  # `allDefines` to know what to imply, so the KEYS of its output depend on
  # reading the registry; and the module system cannot hand over the merged
  # registry until every definition of it is known, including the cascade's. One
  # collection gives `infinite recursion encountered` with no usable trace.
  #
  # Reading one option to write another has no such loop, which is what the plan
  # recorded for the same problem one level up: "no self-reference, since the
  # registry being read is a different option from the one being written".
  options.den.serviceTypes = mkOption {
    # THE REGISTRY ARGUMENT IS EMPTY, and it has to be.
    #
    # The service type takes the registry a want resolves against. Passing
    # `config.den.services` here closes a cycle the moment instances are
    # generated FROM definitions: forcing any definition needs this type, the
    # type needs `den.services`, and `den.services` is the cascade over these
    # definitions. Measured as `infinite recursion encountered` the first time
    # connection.nix's types moved here.
    #
    # Empty is also the honest value rather than a workaround: NOTHING RESOLVES
    # ON A DEFINITION. A definition's `uses` are the schema's edges -- "a celler
    # needs a postgres" -- and only an instance has a scope to resolve them
    # from. So `resolved` on a definition should fail, and with an empty
    # registry it fails saying nothing declares what was asked for, which is
    # true.
    type = types.attrsOf (serviceLibs.mkServiceType { });
    default = { };
    description = ''
      Service DEFINITIONS, keyed by class name -- what a celler is, what a
      celler-cache is. A definition names no host and declares no placement; it
      says what the thing GIVES, what it DEFINES, what it USES and what it
      OBLIGES of whoever includes it.

      Instances come from `den.services`, generated from each host's `runs`.
      Nothing resolves on a definition: its `uses` are the schema's edges, and
      only an instance has a scope to resolve them from.
    '';
  };

  options.den.services = mkOption {
    type = types.attrsOf (serviceLibs.mkServiceType config.den.services);
    default = { };
    description = ''
      Services identified by their RESOLVED DEPENDENCIES, owned by anything --
      a household, a host, or the fleet. Keyed by DECLARATION name, because the
      `identity` is derived (`main/celler@secondpc`) and so cannot BE the key.
      The collision check therefore lives on each instance's own `identity`
      rather than in a separate derived value: laziness makes an unconsumed
      check dead code, so it has to sit on the thing every consumer reads.
    '';
  };

  config = {
    den.schema.service.parent = "household";

    den.schema.host =
      { config, ... }:
      {
        # Attached here rather than as a separate `den.schema.host.includes`
        # definition: this file already defines `den.schema.host` as a function,
        # and the two forms cannot coexist ("already defined").
        # NOTHING HERE. `includes` written inside a FUNCTION-FORM
        # `den.schema.host` is SILENTLY IGNORED -- traced: an aspect added this
        # way never printed while forcing `systemd.services`, and a `throw` in
        # `den.policies.service-aspects`' own returned list never fired. So that
        # policy has never run in this tree. The attr form lives in
        # ./service-implement.nix, which is the only file allowed to use it
        # (den rejects both forms for one key, even across files).

        options.services = mkOption {
          type = types.attrsOf (
            types.submodule {
              options.enable = mkOption {
                type = types.bool;
                default = false;
                description = "This host serves its household's service of this name.";
              };
            }
          );
          default = { };
          example = lib.literalExpression "{ audiobookshelf.enable = true; postgres.enable = true; }";
          description = ''
            This host's CLAIMS on its household's services -- the manifest of
            what the machine runs, so one glance says what it serves. The
            service itself is declared on the household; a claim on a name the
            household does not declare is an evaluation error rather than a
            silent no-op, which is the typo-safety `attrsOf` otherwise loses.
          '';
        };

        # Claimed AND declared, with the throw. Read this, not `services`, when
        # the question is "what does this host actually serve".
        options.serves = mkOption {
          type = types.raw;
          readOnly = true;
          default =
            let
              claimed = lib.attrNames (lib.filterAttrs (_: s: s.enable) config.services);
              declared = if config.household == null then { } else config.household.services;
              missing = lib.subtractLists (lib.attrNames declared) claimed;
            in
            if missing == [ ] then
              lib.getAttrs claimed declared
            else
              throw "den.hosts.*.${config.name}.services claims ${lib.concatStringsSep ", " missing}, which ${
                if config.household == null then
                  "cannot exist: this host sets no `household`, so it has no services to claim"
                else
                  "den.households.${config.household.name} does not declare. It declares: ${
                    let
                      names = lib.attrNames declared;
                    in
                    if names == [ ] then "nothing" else lib.concatStringsSep ", " names
                  }"
              }";
          description = "The household services this host both claims and that exist, keyed by name.";
        };
      };

    # THE CONSUMER. For each service PLACED on this host that has an aspect,
    # resolve that aspect once in a scope bound to the service instance, so the
    # aspect is a function of its own entity (`{ service, ... }`).
    #
    # Only services placed directly on a host (`host != null`) get a scope. A
    # CHILD -- a cache on a celler -- deliberately does not: §3a established
    # that resolving one aspect in two scopes double-declares any forward it
    # reaches (`den.fwd."provision/..." is already declared`), and the parent
    # aspect reads `service.children` as data instead. One scope per parent.
    #
    # The corollary, and it is load bearing: a host must NOT also include the
    # aspect directly. Doing both is the collision. `resolve` is used BARE here,
    # not wrapped in `include` -- wrapping it silently yields no scope at all.
    # ── `implement`, DELIVERED THROUGH A DECLARED ASPECT ──
    #
    # A service's own content as a function of what it resolved. `wrap`
    # partially applies only the bindings the body declares, so a body asking
    # for `{ tcp, cache, ... }` gets the link and its cache and nothing else.
    #
    # Verified bindings: `pull/main/celler@secondpc` gets
    # `tcp = { address = "127.0.0.1"; carrier = "loopback"; port = 8069;
    # protocol = "http://"; }` and `cache` with `serviceName = "main"`, so the
    # body renders `http://127.0.0.1:8069/main` naming no carrier.
    #
    # A DECLARED ASPECT, NOT AN INLINE MODULE. The obvious shape --
    # `resolve.to.withIncludes "service" [ { nixos = wrap ...; } ]` -- produces
    # NOTHING, silently: secondpc's `trusted-substituters` came back with only
    # the old quirk's entry and not the rendered one. That is the second time
    # this session an attrset-that-looks-like-an-aspect no-opped in this family
    # of call, and it is in character -- the note below records that `resolve`
    # wrapped in `include` also silently yields no scope at all. So the content
    # goes through the channel that is PROVEN to fold: a real
    # `den.aspects.<n>`, resolved in the service's scope exactly as the `aspect`
    # arm does.
    #
    # ONE aspect for every implementing service, not one each. It declares no
    # forward, which is what makes that safe: §3a's collision
    # (`den.fwd."provision/..." is already declared`) comes from resolving an
    # aspect that REACHES a forward in two scopes, and this one reaches none.
    # `wrap` RETURNS A MODULE, so it is imported rather than returned as
    # content. Written as `nixos = { service, ... }: wrap ...` the class content
    # became a function returning a function, which is not module content and
    # landed nothing -- silently, like every other wrong shape in this family.
    #
    # `imports` may reference a module ARG but not `config`; `service` is an arg
    # bound by the resolve, so this is allowed. (The `config`-in-`imports` rule
    # is the one that cost hours earlier in this model: a want schema cannot be
    # delivered through `imports` at all, because `den.serviceSchemas` IS
    # config.)
    den.policies.service-aspects =
      {
        host ? { },
        ...
      }:
      let
        mine =
          pred:
          lib.filterAttrs (
            _: s: s.host != null && s.host == (host.name or null) && pred s
          ) config.den.services;
      in
      lib.mapAttrsToList (
        _: service: den.lib.policy.resolve.to.withIncludes "service" [ service.aspect ] { inherit service; }
      ) (mine (s: s.aspect != null))

      ++ lib.mapAttrsToList (
        _: service:
        den.lib.policy.resolve.to.withIncludes "service" [
          den.aspects.service-implement
        ] { inherit service; }
      ) (mine (s: s.implement != null));

    # The service registry as a module arg, for the aspects that need it at
    # host scope. Named `denServices` rather than `services` so it cannot be
    # confused with NixOS's own `config.services`.
    _module.args.denServices = config.den.services;

    # §0's escape hatch for the one question a service may not ask itself:
    # which hosts serve it. `service -> [ host ]`, in the spirit of
    # ../hosts/fleet.nix.
    _module.args.serviceHosts = lib.zipAttrs (
      lib.concatLists (
        lib.mapAttrsToList (
          hname: h:
          map (svc: { ${svc} = hname; }) (lib.attrNames (lib.filterAttrs (_: s: s.enable) h.services))
        ) (lib.concatMapAttrs (_: hosts: hosts) den.hosts)
      )
    );
  };

  # ── THE CAPABILITY, DECLARED WHERE SERVICES ARE MODELLED ──
  #
  # Last of the moves out of ./capability-types.nix. "households services is
  # more of an abstraction over a capability that i think aspects should
  # provide which is a service" -- so what a service IS belongs in the file
  # that holds that abstraction, next to the two collections above, rather
  # than in the capability registry.
  # ── SOMETHING A HOUSEHOLD OFFERS ITS MEMBERS ──
  #
  # "households services is more of an abstraction over a capability that
  # aspects should provide, which is a service" -- and "the service
  # capability has character to it that household consumes".
  #
  # So the ASPECT gives it and the HOUSEHOLD consumes the character. What a
  # grant in a service MEANS is the service's own fact: vikunja's levels are
  # vikunja's, donetick maps `admin_groups` in its own config, splitpro has
  # no role model at all. ../../lib/service-type.nix's `access` option
  # already says it is "filled in by the service's own aspect" -- it just
  # was not, it was written out in ../households/ivymectin.nix, which is the
  # same fact in two places with one reader.
  #
  # WHAT IS NOT HERE, deliberately:
  #
  #   reach      already on the giver (`den.schema.aspect.reach`), and it is
  #              what resolution honours. Restating it here would be the
  #              third copy of a fact that has already had two.
  #   endpoints  the ports are `gives.tcp`/`gives.http`; a service is not a
  #              second place for them.
  #   who serves it   inclusion. A host that includes the aspect gives the
  #              service, exactly as a host that includes `tailscale` is on
  #              the tailnet -- "nothing to declare and nothing that can
  #              disagree with reality".
  # `config.den.capabilities`, not a bare `den`: this file carries explicit
  # `options.` and `config.` attributes, and mixing the two forms is "has an
  # unsupported attribute `den'" -- the same thing ./capability-types.nix's
  # `caps` export hit.
  config.den.capabilities.service = {
    meta.description = "Something a household offers its members, and what a grant in it means.";
    includes = [ caps.carried ];

    options = {
      displayName = mkOption {
        type = types.nullOr types.str;
        default = null;
        description = "Human-facing name, where it differs from the aspect's own.";
      };

      # RAW, and that is not laziness: there is deliberately no central
      # `levels` enum, because Home Assistant maps groups to roles, donetick
      # has `admin_groups`, splitpro has no role model and audiobookshelf's
      # mapping is not declarative at all. Null for a service with nothing
      # to say about permissions -- nextcloud and garage both mean it.
      access = mkOption {
        type = types.nullOr types.raw;
        default = null;
        example = lib.literalExpression ''{ levels = [ "user" "admin" ]; defaultLevel = "user"; }'';
        description = "What a grant in this service means, or null where a grant would mean nothing.";
      };

      # ── WHERE A GRANT CANNOT BE HONOURED FROM NIX AT ALL ──
      #
      # plex authenticates with an X-Plex-Token minted at plex.tv and shares a
      # library in its own UI; immich and audiobookshelf keep their own
      # accounts. For those a grant is the household's REGISTER of who uses
      # what -- which ../services/homepage.nix reads to decide whose dashboard
      # shows it -- and nothing more.
      #
      # Declared rather than left silent, because the two are
      # indistinguishable otherwise: ../services/access.nix's
      # `access-grants-land` check reports a grant that realises nothing, and
      # this is how a service says the answer is "by hand, elsewhere" instead
      # of "somebody forgot".
      externallyManaged = mkOption {
        type = types.bool;
        default = false;
        description = "A grant here is a record, not an instruction: the accounts are this app's own and nothing in nix can open them.";
      };

      # A TAG, and the one field whose home is arguable: sonarr does not
      # know it is part of this house's media stack. It is furnished here
      # for provenance -- the grant that covers six services has to name
      # them from somewhere -- while the LEVELS that grant carries stay on
      # the household's `serviceGroups`, because what a grant means to
      # PEOPLE is the house's fact and not the app's.
      group = mkOption {
        type = types.nullOr types.str;
        default = null;
        example = "arr";
        description = "Grants this service alongside others carrying the same tag.";
      };
    };
  };
}
