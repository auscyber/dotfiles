{
  inputs,
  den,
  lib,
  ...
}:
let
  # Bootstrap guard. This module is imported for EVERY evaluation of the flake,
  # including the one `write-flake` runs to build its own writer -- which is the
  # evaluation that has to succeed *before* `inputs.files` is in any lock. Same
  # reason ../framework/den.nix guards its `or { }` imports.
  hasFiles = inputs ? files;

  # The nixd settings, as the lua that installs them. Kept as text rather than
  # an attrset run through `toJSON` so the `expr` strings -- the only part worth
  # eye-checking -- read as nix expressions in the generated file.
  #
  # `root` is resolved at RUNTIME from the file's own path, so nothing bakes in
  # an absolute checkout path: `rootPath`/`self` would both render as the
  # /nix/store snapshot this file was generated from, which is a frozen copy of
  # the tree and the opposite of what is wanted.
  nvimLua = ''
    -- GENERATED by `nix run .#write-files` from aspects/tooling/nixd.nix.
    -- Do not edit by hand; `nix flake check` (`files:.nvim.lua`) fails if you do.
    --
    -- Project-local nixd settings, sourced by neovim's `exrc`. Run `:trust` once
    -- in a fresh checkout to let nvim read it.

    -- The repo root, found from this file's own location rather than hardcoded:
    -- `rootPath`/`self` would both render as the /nix/store snapshot this file
    -- was generated from, which is a frozen copy of the tree.
    local here = vim.fs.abspath(debug.getinfo(1, "S").source:sub(2))
    local root = assert(vim.fs.root(here, "flake.nix"), "no flake.nix above " .. here)

    -- WHICH MACHINE THIS IS, resolved at run time. The two platforms park host
    -- configurations under different attributes and both key them by hostname,
    -- so one generated file stays correct on a darwin box and on a NixOS one.
    local host = vim.uv.os_gethostname()
    local configurations = vim.uv.os_uname().sysname == "Darwin" and "darwinConfigurations"
      or "nixosConfigurations"

    -- The ONLY string building in here: a nix attribute path hanging off
    -- `builtins.getFlake`. Every segment is quoted, so a host called
    -- `Ivys-MacBook-Pro` and a leading-underscore attr like `_finalPkgs` need
    -- no special case and nothing has to be escaped by hand.
    local function expr(...)
      local parts = { ("(builtins.getFlake %q)"):format(root) }
      vim.iter({ ... }):flatten():each(function(segment)
        parts[#parts + 1] = ("%q"):format(segment)
      end)
      return table.concat(parts, ".")
    end

    local function thisHost(...)
      return expr(configurations, host, ...)
    end

    local settings = {
      nixd = {
        -- Package and `lib` completion. `currentSystem._finalPkgs` is this
        -- repo's own package set -- every collected overlay applied -- so
        -- `pkgs.lspmuxed`, `pkgs.celler` and friends complete too. Swap for
        -- `expr("inputs", "nixpkgs")` wrapped in `import ... { }` to get a
        -- bare nixpkgs instead.
        nixpkgs = { expr = expr("currentSystem", "_finalPkgs") },

        formatting = { command = { "nixfmt" } },

        -- One entry per option universe. nixd offers all of them, so each is a
        -- separate evaluation -- see the note at the bottom of this file.
        options = {
          -- The fleet's biggest NixOS host, so it resolves the widest set of
          -- aspects. Any host costs roughly the same (measured: ~26s, almost
          -- all of it copying the tree into the store), so there is nothing to
          -- gain by pointing this at a smaller one.
          nixos = { expr = expr("nixosConfigurations", "secondpc", "options") },

          -- nix-darwin options live under their own configurations attr.
          darwin = { expr = expr("darwinConfigurations", "Ivys-MacBook-Pro", "options") },

          -- THIS machine's own options, whichever platform it is.
          ["this-host"] = { expr = thisHost("options") },

          -- HOME-MANAGER AS THIS HOST MANAGES IT, which is the universe an
          -- aspect's `provides.to-users.homeManager` body is actually checked
          -- against. It was `homeConfigurations."ivy@contabo".options` -- a
          -- STANDALONE home, a different module set from the host-managed one,
          -- and a host this machine has nothing to do with.
          --
          -- `options.home-manager.users` is `attrsOf (submoduleWith ...)`, and a
          -- submodule's option tree is reachable only through its type:
          -- `getSubOptions` is what renders it, and asking the type rather than
          -- a user means no account name is baked in here.
          ["home-manager"] = {
            expr = thisHost("options", "home-manager", "users", "type") .. ".getSubOptions []",
          },

          -- The flake-parts module system itself: `den.*`, `perSystem`, every
          -- option an aspect file writes at flake level. `debug.options` is the
          -- whole flake module's option set; `currentSystem.options` is the
          -- perSystem one (`packages`, `checks`, `_lspServers`, ...).
          ["flake-parts"] = { expr = expr("debug", "options") },
          ["flake-parts-perSystem"] = { expr = expr("currentSystem", "options") },
        },
      },
    }

    -- `nixd`, not `nil_ls`. The registry entry in aspects/tooling/nixd.nix is
    -- keyed `nixd` with `exe = "nixd"`, and `lspconfig` defaults to `exe`, so
    -- that is the client name nixvim installs. Configuring `nil_ls` here sent
    -- these settings to a server nothing starts.
    --
    -- `vim.lsp.config` MERGES onto the config nixvim already installed, so the
    -- `cmd` pointing at the lspmux-wrapped nixd survives and only `settings` is
    -- added.
    vim.lsp.config("nixd", { settings = settings })

    -- `exrc` is sourced during startup, before any buffer attaches, so the merge
    -- above is normally enough. This covers the other order: `:trust` plus
    -- `:source .nvim.lua` in a session where nixd is already running.
    for _, client in ipairs(vim.lsp.get_clients({ name = "nixd" })) do
      client.settings = vim.tbl_deep_extend("force", client.settings or {}, settings)
      client:notify("workspace/didChangeConfiguration", { settings = client.settings })
    end

    -- COST, so it is not a surprise: each `options` entry above runs
    -- `builtins.getFlake` on this working tree. A plain absolute path resolves
    -- as a `path:` flakeref, which copies the WHOLE tree into the store (so
    -- untracked files are visible -- unlike `nix build .#...`, which goes
    -- through git) and does so again after every edit. Expect ~25s of apparent
    -- hang on nixd's first option request after a save, then instant answers
    -- until the next one.
  '';
in
{
  # `flake = false`: the upstream flake is development-only and throws if you
  # import `flakeModules.default`; the module is the file.
  ff.files = {
    url = "github:mightyiam/files";
    flake = false;
  };

  # Root lock, not the `dev` layer. ../framework/layers.nix reserves the root for
  # inputs the root flake resolves before any layer does -- and this module's
  # flakeModule is imported unconditionally at flake level, exactly like
  # treefmt-nix (./formatter.nix) and devshell (./devshells.nix), both `ff.*`.
  # The aspect-tagged route (`den.aspects.<x>.inputs` + `layers = [ "dev" ]`)
  # only writes inputs for aspects something resolves: ./deploy.nix declares
  # deploy-rs that way and it appears in no lock at all.
  imports = lib.optional hasFiles "${inputs.files}/flake-module.nix";
  den.aspects.nixd.lsp-servers = { pkgs, ... }: {
    nixd = {
      # ── nixd EMBEDS CppNIX, SO IT NEEDS THE PLURAL FEATURE NAME ──
      #
      # This fleet runs Lix, which spells the feature `pipe-operator`
      # (singular) -- ../base/nix.nix picks that name per host and writes it to
      # nix.conf. nixd links CppNix instead (`nixVersions.latest.libs` in its
      # own package), which wants `pipe-operators`, so without this it reports
      # "experimental Nix feature 'pipe-operators' is disabled" on every file
      # using `|>`: ./patch-inputs.nix, ./nh-checked.nix, ./extraPackages.nix
      # and ./templates.nix. Verified against the 2.35 binary it links.
      #
      # Both spellings coexist because different binaries read them. Lix cannot
      # be substituted here: nixd wants the COMPONENTISED nix libraries
      # (`nix-expr`, `nix-main`, `nix-cmd`, `nix-flake`) and Lix ships one
      # monolithic package with no `.libs`, which is why `lixPackageSets` has
      # `nil` and no `nixd`.
      #
      # `--prefix`, not `--set`: ../../lib/without-celler.nix passes its own
      # NIX_CONFIG through, so this appends instead of replacing it.
      package = pkgs.symlinkJoin {
        name = "nixd-pipe-operators";
        paths = [ pkgs.nixd ];
        nativeBuildInputs = [ pkgs.makeWrapper ];
        postBuild = ''
          wrapProgram $out/bin/nixd \
            --prefix NIX_CONFIG $'\n' 'extra-experimental-features = pipe-operators'
        '';
      };
      exe = "nixd";
      zed = "nix";
      opencode = "nixd";
      extensionToLanguage.".nix" = "nix";
    };
  };
  den.aspects.lspmux.includes = [ den.aspects.nixd ];

  perSystem =
    _:
    lib.optionalAttrs hasFiles {
      files.file.".nvim.lua".text = nvimLua;
      # `apps.write-files`.
      files.writer.app = true;
    };
}
