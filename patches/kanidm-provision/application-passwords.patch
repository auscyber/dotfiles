+fn sync_applications(
+    state: &State,
+    kanidm_client: &KanidmClient,
+    existing_groups: &HashMap<String, Value>,
+) -> Result<()> {
+    log_status("Syncing applications");
+    for (name, application) in &state.applications {
+        if !application.present {
+            continue;
+        }
+
+        if kanidm_client.get_application_uuid(name)?.is_some() {
+            continue;
+        }
+
+        // The linked group must already exist -- sync_groups runs first -- and
+        // the application is created with its uuid, not its name.
+        let group = existing_groups.get(&application.linked_group).ok_or_else(|| {
+            eyre!(
+                "Cannot create application '{name}': linked group '{}' does not exist",
+                application.linked_group
+            )
+        })?;
+
+        let group_uuid = group
+            .get("uuid")
+            .and_then(Value::as_str)
+            .ok_or_else(|| eyre!("Group '{}' has no uuid", application.linked_group))?;
+
+        kanidm_client.create_application(name, &application.display_name, group_uuid, &application.linked_group)?;
+    }
+
+    Ok(())
+}
