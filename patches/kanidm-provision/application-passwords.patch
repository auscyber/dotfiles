+    pub fn create_application(&self, name: &str, display_name: &str, group_uuid: &str, group_name: &str) -> Result<()> {
+        log_event("Creating", &format!("{ENDPOINT_SCIM_APPLICATION}/{name}"));
+
+        self.client
+            .post(format!("{}{ENDPOINT_SCIM_APPLICATION}", self.url))
+            .headers(self.idm_admin_headers.clone())
+            // Field for field with kanidm's ScimEntryApplicationPost.
+            .json(&json!({
+                "name": name,
+                "displayname": display_name,
+                "linked_group": { "uuid": group_uuid, "value": group_name }
+            }))
+            .send()?
+            .get_json_response()?;
+
+        Ok(())
+    }
