+        let secret = secret.trim();
+
+        log_event(
+            "Setting",
+            &format!("{ENDPOINT_SCIM_PERSON}/{person}/Application/_create_password {label}"),
+        );
+
+        self.client
+            .post(format!(
+                "{}{ENDPOINT_SCIM_PERSON}/{person}/Application/_create_password",
+                self.url
+            ))
+            .headers(self.idm_admin_headers.clone())
+            .json(&json!({
+                "applicationUuid": application_uuid,
+                "label": label,
+                "secret": secret
+            }))
+            .send()?
+            .get_json_response()?;
+
+        Ok(())
+    }
