+fn sync_service_accounts(
+    state: &State,
+    kanidm_client: &KanidmClient,
+    existing_service_accounts: &mut HashMap<String, Value>,
+    preexisting_entity_names: &HashSet<String>,
+) -> Result<()> {
+    log_status("Syncing service accounts");
+    for (name, account) in &state.service_accounts {
+        if account.present {
+            if !existing_service_accounts.contains_key(name) {
+                if preexisting_entity_names.contains(name) {
+                    bail!("Cannot create service account '{name}' because the name is already in use by another entity!");
+                }
+
+                kanidm_client.create_entity(
+                    ENDPOINT_SERVICE_ACCOUNT,
+                    name,
+                    &json!({ "attrs": {
+                        "name": [ name ],
+                        "displayname": [ account.display_name ],
+                        "entry_managed_by": [ account.entry_managed_by ]
+                    }}),
+                )?;
+                existing_service_accounts.clear();
+                existing_service_accounts.extend(kanidm_client.get_entities(ENDPOINT_SERVICE_ACCOUNT)?);
+            }
+
+            update_attrs!(kanidm_client, ENDPOINT_SERVICE_ACCOUNT, &existing_service_accounts, &name, false, [
+                "displayname": vec![account.display_name.clone()],
+                "entry_managed_by": vec![account.entry_managed_by.clone()],
+            ]);
+
+            // A token's value is returned once, at creation. So a label kanidm
+            // already knows is left alone -- rotating it every run would hand
+            // out a token nothing else has -- and only a missing one is minted.
+            if !account.api_tokens.is_empty() {
+                let existing_labels = kanidm_client.list_api_token_labels(name)?;
+                for (label, token) in &account.api_tokens {
+                    if existing_labels.iter().any(|l| l == label) {
+                        continue;
+                    }
+
+                    let value = kanidm_client.create_api_token(name, label, token.read_write, token.compact)?;
+                    let path = Path::new(&token.file);
+                    if let Some(dir) = path.parent() {
+                        fs::create_dir_all(dir)
+                            .context(format!("Failed to create directory for {}", path.display()))?;
+                    }
+                    fs::write(path, &value)
+                        .context(format!("Failed to write api token to {}", path.display()))?;
+                    fs::set_permissions(path, fs::Permissions::from_mode(0o600))
+                        .context(format!("Failed to restrict permissions on {}", path.display()))?;
+                }
+            }
+        } else if existing_service_accounts.contains_key(name) {
+            kanidm_client.delete_entity(ENDPOINT_SERVICE_ACCOUNT, name)?;
+        }
+    }
+
+    Ok(())
+}
