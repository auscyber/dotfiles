+    /// Labels of the api tokens this service account already has. Kanidm will
+    /// happily mint a second token with the same label, so the caller has to
+    /// check before creating one or every run would issue a new one.
+    pub fn list_api_token_labels(&self, name: &str) -> Result<Vec<String>> {
+        let response = self
+            .client
+            .get(format!("{}{ENDPOINT_SERVICE_ACCOUNT}/{name}/_api_token", self.url))
+            .headers(self.idm_admin_headers.clone())
+            .send()?
+            .get_json_response()?;
+
+        Ok(response
+            .as_array()
+            .map(|tokens| {
+                tokens
+                    .iter()
+                    .filter_map(|t| t.get("label").and_then(Value::as_str).map(ToOwned::to_owned))
+                    .collect()
+            })
+            .unwrap_or_default())
+    }
+
+    /// Mint a token and return it. The value is only ever returned here -- it
+    /// cannot be read back afterwards -- so the caller must persist it.
+    pub fn create_api_token(&self, name: &str, label: &str, read_write: bool, compact: bool) -> Result<String> {
+        log_event(
+            "Creating",
+            &format!("{ENDPOINT_SERVICE_ACCOUNT}/{name}/_api_token {label}"),
+        );
+
+        let response = self
+            .client
+            .post(format!("{}{ENDPOINT_SERVICE_ACCOUNT}/{name}/_api_token", self.url))
+            .headers(self.idm_admin_headers.clone())
+            // Field for field with kanidm's ApiTokenGenerate: label, expiry,
+            // read_write, compact.  is not optional server-side, so
+            // omitting it fails the deserialize rather than defaulting.
+            .json(&json!({
+                "label": label,
+                "expiry": Value::Null,
+                "read_write": read_write,
+                "compact": compact
+            }))
+            .send()?
+            .get_json_response()?;
+
+        response
+            .as_str()
+            .map(ToOwned::to_owned)
+            .ok_or_else(|| eyre!("Kanidm did not return a token string for {name}/{label}"))
     }
 
