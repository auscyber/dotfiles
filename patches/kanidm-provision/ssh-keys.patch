+
+    /// The TAGS of the ssh public keys this person already has. kanidm
+    /// addresses an ssh key by its tag, so a tag is what has to be compared to
+    /// decide whether a key is new, changed or gone -- the same shape
+    /// `list_api_token_labels` uses for tokens.
+    pub fn list_ssh_pubkey_tags(&self, person: &str) -> Result<Vec<String>> {
+        let response = self
+            .client
+            .get(format!("{}{ENDPOINT_PERSON}/{person}/_ssh_pubkeys", self.url))
+            .headers(self.idm_admin_headers.clone())
+            .send()?
+            .get_json_response()?;
+
+        // Each entry reads `tag: ssh-... comment`, which is kanidm's own
+        // rendering of an ssh key value (`to_proto_string_clone`). Only the tag
+        // is wanted, and splitting on the first colon is what recovers it.
+        Ok(response
+            .as_array()
+            .map(|keys| {
+                keys.iter()
+                    .filter_map(Value::as_str)
+                    .filter_map(|k| k.split_once(':'))
+                    .map(|(tag, _)| tag.trim().to_owned())
+                    .collect()
+            })
+            .unwrap_or_default())
+    }
+
+    /// Add or replace one ssh public key. POSTing a tag that already exists
+    /// REPLACES it, which is what makes this idempotent and is why there is no
+    /// read-compare-write here: a key whose material changed under an unchanged
+    /// tag is corrected by the same call that would have created it.
+    pub fn set_ssh_pubkey(&self, person: &str, tag: &str, key: &str) -> Result<()> {
+        log_event("Setting", &format!("{ENDPOINT_PERSON}/{person}/_ssh_pubkeys {tag}"));
+
+        self.client
+            .post(format!("{}{ENDPOINT_PERSON}/{person}/_ssh_pubkeys", self.url))
+            .headers(self.idm_admin_headers.clone())
+            .json(&json!([tag, key]))
             .send()?
             .get_json_response()?;
 
         Ok(())
     }
 
+    /// Remove an ssh public key by tag. Used for a tag kanidm holds that the
+    /// declaration no longer names, so a key removed from the state is removed
+    /// from the person -- the declaration is authoritative, which is the whole
+    /// point of provisioning them.
+    pub fn delete_ssh_pubkey(&self, person: &str, tag: &str) -> Result<()> {
+        log_event("Deleting", &format!("{ENDPOINT_PERSON}/{person}/_ssh_pubkeys/{tag}"));
+
+        self.client
+            .delete(format!("{}{ENDPOINT_PERSON}/{person}/_ssh_pubkeys/{tag}", self.url))
+            .headers(self.idm_admin_headers.clone())
+            .send()?
+            .get_json_response()?;
+
+        Ok(())
+    }
+
