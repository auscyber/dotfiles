+
+  # Reads what installSecrets recorded and restarts it -- called after
+  # chownSecrets everywhere installSecrets is, so a unit never starts back up
+  # against a secret still owned by root from before the chown.
+  restartUnits = ''
+    if [ -f /run/agenix-restart-units ]; then
+      echo "[agenix] restarting units: $(tr '\n' ' ' < /run/agenix-restart-units)"
+      ${
+        if isDarwin then
+          ''
+            while read -r unit; do
+              launchctl kickstart -k "system/$unit"
+            done < /run/agenix-restart-units
+          ''
+        else
+          ''
+            ${pkgs.systemd}/bin/systemctl try-restart $(cat /run/agenix-restart-units)
+          ''
+      }
+      rm -f /run/agenix-restart-units
+    fi
+    if [ -f /run/agenix-restart-user-units ]; then
+      echo "[agenix] restarting user units: $(tr '\n' ' ' < /run/agenix-restart-user-units)"
+      while IFS=: read -r user unit; do
+        ${
+          if isDarwin then
+            ''
+              uid=$(id -u "$user")
+              launchctl kickstart -k "gui/$uid/$unit"
+            ''
+          else
+            ''${pkgs.systemd}/bin/systemctl --user -M "$user@" try-restart "$unit"''
+        }
+      done < /run/agenix-restart-user-units
+      rm -f /run/agenix-restart-user-units
+    fi
+  '';
