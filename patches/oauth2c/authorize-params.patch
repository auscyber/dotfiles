+// VerifyState compares the state returned on the callback against the state
+// that was sent on the authorization request.
+//
+// RFC 6749 section 10.12 makes this the client's defence against an attacker
+// pasting their own authorization code into someone else's callback, and
+// section 4.1.2 makes `state` REQUIRED in the response whenever it was present
+// in the request. oauth2c always sends one, so a response that carries none is
+// a protocol violation rather than merely an unverifiable one -- both are
+// rejected, because "absent" is exactly what an injected redirect looks like.
+//
+// PKCE does not make this redundant. The code_challenge binds the code to this
+// CLIENT, which is a different property from binding the callback to the
+// authorization request this client actually started (RFC 6819 section
+// 4.4.1.8); a loopback listener narrows who can reach the callback, which is
+// mitigation rather than a substitute.
+func VerifyState(sent, got string) error {
+	if sent == "" {
+		return errors.New("state verification: no state was sent on the authorization request")
+	}
+
+	if got == "" {
+		return errors.New("state verification: the callback carried no state parameter")
+	}
+
+	if subtle.ConstantTimeCompare([]byte(sent), []byte(got)) != 1 {
+		return errors.New("state verification: the callback did not come from the authorization request this client started")
+	}
+
+	return nil
 }
 
