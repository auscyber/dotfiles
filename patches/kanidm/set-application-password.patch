+/// Set an application password to a value chosen by the CALLER, rather than one
+/// the server mints.
+///
+/// This exists for declarative provisioning: a fleet generates the secret
+/// offline into a secret store and pushes it here when the server is next up.
+/// The user-facing flow is untouched -- `GenerateApplicationPasswordEvent` still
+/// mints and returns, so a person cannot choose their own.
+///
+/// Carries the CALLER's identity, not an internal one, so the modify below is
+/// still subject to access controls. Restricting this to provisioning is done
+/// at the API edge; relying on an internal identity here would make that check
+/// the only thing standing between any authenticated caller and setting
+/// anyone's credential.
+#[derive(Debug)]
+pub struct SetApplicationPasswordEvent {
+    pub ident: Identity,
+    pub target: Uuid,
+    pub application: Uuid,
+    pub label: String,
+    pub cleartext: String,
+}
+
+impl SetApplicationPasswordEvent {
+    pub fn from_parts(
+        ident: Identity,
+        target: Uuid,
+        application: Uuid,
+        label: String,
+        cleartext: String,
+    ) -> Result<Self, OperationError> {
+        Ok(SetApplicationPasswordEvent {
+            ident,
+            target,
+            application,
+            label,
+            cleartext,
+        })
     }
 }
 
