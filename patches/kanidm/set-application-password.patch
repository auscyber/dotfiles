+    /// Idempotently set an application password to a supplied value, returning
+    /// the uuid of the password that now holds it.
+    ///
+    /// When the value is already set for this application and label, NOTHING is
+    /// modified and the existing uuid is returned. That is the point rather than
+    /// an optimisation: a provisioning tool runs on every start and
+    /// `Password::new` salts, so writing unconditionally would store a
+    /// different value each boot and churn the entry forever.
+    ///
+    /// Refuses a secret that already authenticates for a DIFFERENT application,
+    /// or for this one under another label. An application password is bound to
+    /// one application by design -- the feature exists so that a credential
+    /// cannot span applications -- so that has to hold here too, enforced by the
+    /// server rather than trusted to whoever is provisioning.
+    #[instrument(level = "debug", skip_all)]
+    pub fn set_application_password(
+        &mut self,
+        ev: &SetApplicationPasswordEvent,
+    ) -> Result<Uuid, OperationError> {
+        let entry = self.qs_write.internal_search_uuid(ev.target)?;
+        let account = Account::try_from_entry_rw(&entry, &mut self.qs_write)?;
+
+        // The existing password this call replaces, if any.
+        let mut replaces: Option<Uuid> = None;
+
+        // One verify per stored application password, so a KDF each. Linear in
+        // how many the person holds, which is a handful -- and it is the only
+        // way to answer "is this already set" or "is this secret reused" when
+        // only hashes are kept.
+        for aps in account.apps_pwds.values() {
+            for ap in aps.iter() {
+                let same_secret = ap.password.verify(ev.cleartext.as_str()).map_err(|err| {
+                    error!(crypto_err = ?err);
+                    OperationError::CryptographyError
+                })?;
+
+                if ap.application == ev.application && ap.label == ev.label {
+                    if same_secret {
+                        debug!("Application password unchanged, no modification made.");
+                        return Ok(ap.uuid);
+                    }
+                    replaces = Some(ap.uuid);
+                    continue;
+                }
+
+                if same_secret {
+                    security_info!(
+                        "Refusing an application password already in use for another application or label."
+                    );
+                    return Err(OperationError::InvalidRequestState);
+                }
+            }
+        }
+
+        let policy = self.crypto_policy();
+        let ap = ApplicationPassword::new(
+            ev.application,
+            ev.label.as_str(),
+            ev.cleartext.as_str(),
+            policy,
+        )
+        .inspect_err(|err| error!(?err, "Unable to set application password."))?;
+
+        let ap_uuid = ap.uuid;
+
+        let mut mods = Vec::with_capacity(2);
+        if let Some(old) = replaces {
+            mods.push(Modify::Removed(
+                Attribute::ApplicationPassword,
+                PartialValue::Uuid(old),
+            ));
+        }
+        mods.push(Modify::Present(
+            Attribute::ApplicationPassword,
+            Value::ApplicationPassword(ap),
+        ));
+
+        self.qs_write
+            .impersonate_modify(
+                &filter!(f_eq(Attribute::Uuid, PartialValue::Uuid(ev.target))),
+                &filter_all!(f_eq(Attribute::Uuid, PartialValue::Uuid(ev.target))),
+                &ModifyList::new_list(mods),
+                &ev.ident,
+            )
+            .inspect_err(|err| error!(?err))
+            .map(|_| ap_uuid)
     }
 
