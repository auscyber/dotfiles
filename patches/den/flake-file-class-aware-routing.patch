   # Collect class modules from a scope and all descendants, skipping isolated
   # descendants (isolation-AWARE; collection root always included). The plain
   # case collects from the route's own scope only.
+
+  # The aspect a collected class module was emitted by. class-collector.nix
+  # tags every entry with `key = "<class>@<identity>"` (and `__loc` for raw
+  # entries), so provenance is already on the module -- no extra bookkeeping.
+  moduleIdentity =
+    mod:
+    let
+      loc = mod.key or mod.__loc or mod._file or null;
+      parts = if builtins.isString loc then lib.splitString "@" loc else [ ];
+    in
+    if builtins.length parts < 2 then null else lib.concatStringsSep "@" (lib.tail parts);
+
+  # Aspects that emitted content for at least one of `classes` anywhere in
+  # `scopes`, as a set for cheap lookup.
+  identitiesEmittingClasses =
+    wrappedPerScope: scopes: classes:
+    lib.listToAttrs (
+      lib.concatMap (
+        sid:
+        lib.concatMap (
+          class:
+          lib.concatMap (
+            mod:
+            let
+              id = moduleIdentity mod;
+            in
+            lib.optional (id != null) {
+              name = id;
+              value = true;
+            }
+          ) (wrappedPerScope.${sid}.${class} or [ ])
+        ) classes
+      ) scopes
+    );
+
+  # `requireClass`: keep only modules whose aspect ALSO contributes to one of
+  # the named classes. den resolves the whole aspect tree for every entity and
+  # gates on class downstream, so an unfiltered collection is class-blind: a
+  # NixOS host collects `flake-file` content from darwin-only aspects, which is
+  # right for a flake-level route (the flake needs every input) but wrong for a
+  # per-host one (which inputs does THIS host need?). Null = collect everything,
+  # which is the pre-existing behaviour and stays the default.
+  filterByRequiredClasses =
+    wrappedPerScope: scopes: requireClass: mods:
+    if requireClass == null || requireClass == [ ] then
+      mods
+    else
+      let
+        allowed = identitiesEmittingClasses wrappedPerScope scopes requireClass;
+      in
+      builtins.filter (
+        mod:
+        let
+          id = moduleIdentity mod;
+        in
+        # An entry with no recoverable identity is kept: dropping it would
+        # silently lose content on any emission path that does not tag a key.
+        id == null || allowed ? ${id}
+      ) mods;
+
   collectFromSubtree =
-    wrappedPerScope: scopeParent: scopeIsolated: rootScopeId: fromClass:
+    wrappedPerScope: scopeParent: scopeIsolated: rootScopeId: fromClass: requireClass:
     let
       scopes = subtreeScopes {
